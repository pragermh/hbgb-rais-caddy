{
    # Optional: Let's Encrypt contact email
    # email you@example.com
}

{$HOST} {
    root * /srv
    encode gzip

    # --- /health endpoint ---
    @health path /health
    handle @health {
        header Content-Type text/plain
        respond "ok\n" 200
    }

    # --- IIIF proxy: ^~ /iiif/ ---
    handle /iiif* {
        reverse_proxy rais:12415 {
            # like: proxy_set_header Host $host:$server_port;
            header_up Host {hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # --- Static /idx, /assets, favicon, robots.txt with caching ---
    @static path_regexp static ^/(idx/|assets/|favicon\.ico$|robots\.txt$)
    handle @static {
        # Similar to: try_files $uri =404;
        try_files {path} {path}/index.html
        # If nothing matches, Caddy returns 404 automatically

        header Cache-Control "public, max-age=604800, immutable"
        file_server
    }

    # --- SPA fallback for everything else (location /) ---
    handle {
        # Like: try_files $uri /index.html;
        try_files {path} /index.html
        file_server
    }

    log {
        level warn
        output stdout
        format console
    }
}

